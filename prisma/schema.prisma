model logs {
    id            Int            @id @default(autoincrement())
    user_id       Int?
    action_type   String
    action_target String
    timestamp     DateTime       @default(now())
    status        ActivityStatus
    source_system String?

    @@index([action_type, timestamp])
}

model users_config {
    id             Int                 @id @default(autoincrement())
    User           users               @relation(fields: [user_id], references: [id])
    user_id        Int                 @unique
    language       Available_Languages @default(PT_BR)
    secret_roll    Boolean             @default(false)
    secret_insan   Boolean             @default(false)
    secret_general Boolean             @default(false)
    secret_sheet   Boolean             @default(false)
    secret_send    Boolean             @default(false)
    last_use       DateTime            @default(now()) @updatedAt @db.Timestamptz
    created_at     DateTime            @default(now())
}

model tutorials {
    id          Int      @id @default(autoincrement())
    link        String   @unique
    title       String
    description String
    thumbnail   String
    tags        String[]
    tutorial    String
}

model resources {
    id       Int                  @id @default(autoincrement())
    name     String
    data     Json
    language Available_Languages?

    @@unique([name, language])
}

model announcement {
    id                    Int                  @id @default(autoincrement())
    content               Json
    title                 String?
    mode                  AnnouncementMode     @default(ONCE)
    repeat_interval_hours Int?
    priority              Int                  @default(0) // Maior = exibido primeiro
    is_active             Boolean              @default(true)
    created_at            DateTime             @default(now())
    seen_by               announcements_seen[]

    @@index([is_active, priority])
}

model announcements_seen {
    id              Int          @id @default(autoincrement())
    user_id         Int
    announcement_id Int
    user            users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
    announcement    announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
    first_seen      DateTime     @default(now())
    last_seen_date  DateTime     @default(now()) @updatedAt @db.Timestamptz

    @@unique([user_id, announcement_id]) // Garante a unicidade do par
    @@index([user_id, last_seen_date])
}
