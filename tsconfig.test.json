{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        /* Projeto referenciado (solution-style) para o editor: references exige composite + emit (TS6306/TS6310). Emite SÓ declarações para .tsbuild (scratch); o build real continua sendo tsconfig.json -> dist/. */
        "composite": true,
        "rootDir": ".",
        "emitDeclarationOnly": true,
        "declarationDir": "./.tsbuild",
        "tsBuildInfoFile": "./.tsbuild/tsconfig.test.tsbuildinfo",
        /* jest: globals de teste (describe/it/expect/jest/beforeEach...); node: Buffer/process/__dirname; express: namespace global Express usado em src/types/global.d.ts. */
        "types": ["node", "jest", "express"]
    },
    "include": ["src", "test"]
}
