# =============================================================================
# Kami Bot HTTP — template de variaveis de ambiente
# =============================================================================
# Copie para:
#   .env       -> desenvolvimento (NODE_ENV diferente de production/test)
#   prod.env   -> producao
#   test.env   -> testes (normalmente definido pelo Jest)
#
# IMPORTANTE: config.ts escolhe o arquivo antes de carregar o dotenv.
# Em producao, defina NODE_ENV=production no processo (PM2/systemd),
# nao apenas dentro do prod.env.
#
# Nunca versione .env, prod.env ou test.env.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Aplicacao
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=development

# Porta HTTP do Express (obrigatoria, sem valor padrao no codigo)
PORT=3000

# -----------------------------------------------------------------------------
# 2. Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/kami?schema=public

# -----------------------------------------------------------------------------
# 3. Discord
# -----------------------------------------------------------------------------
# Developer Portal > Bot > Token
BOT_TOKEN=troque_pelo_token_do_bot

# Developer Portal > General Information > Public Key (64 caracteres hex)
PUBLIC_KEY=troque_pela_public_key_da_aplicacao

# Application ID (18 a 20 digitos)
CLIENT_ID=123456789012345678

# Developer Portal > OAuth2 > Client Secret
CLIENT_SECRET=troque_pelo_client_secret

# ID do usuario dono do bot (18 a 20 digitos)
OWNER_ID=123456789012345678

# -----------------------------------------------------------------------------
# 4. Webhooks do Discord
# -----------------------------------------------------------------------------
# Webhook de registro/atualizacao de comandos
COMMAND_WEBHOOK_ID=123456789012345678
COMMAND_WEBHOOK_TOKEN=troque_pelo_token_do_webhook_de_comandos

# Webhook de logs
LOG_WEBHOOK_ID=123456789012345678
LOG_WEBHOOK_TOKEN=troque_pelo_token_do_webhook_de_logs

# -----------------------------------------------------------------------------
# 5. Logs, status e API
# -----------------------------------------------------------------------------
# Canal onde os logs sao enviados
LOG_CHANNEL_ID=123456789012345678

# Canal e mensagem do painel de status
BOT_STATUS_CHANNEL_ID=123456789012345678
BOT_STATUS_MESSAGE_ID=123456789012345678

# Cor dos embeds em hexadecimal (0x0082FF = #0082FF)
EMBED_COLOR=0x0082FF

# Token exigido no header Authorization das rotas internas (ex.: /health/status)
API_TOKEN=troque_por_um_token_longo_e_aleatorio

# -----------------------------------------------------------------------------
# 6. Tipo de instancia
# -----------------------------------------------------------------------------
# primary | backup
INSTANCE_TYPE=primary

# -----------------------------------------------------------------------------
# 7. Failover — somente quando INSTANCE_TYPE=backup
# -----------------------------------------------------------------------------
# /health/status da instancia primaria.
# Use o hostname direto da tunel primaria; nao use "bot", pois ele muda de alvo.
PRIMARY_INSTANCE_STATUS_URL=https://primary-bot.url.com.br/health/status

# Deve ser identico ao API_TOKEN configurado na instancia primaria.
PRIMARY_INSTANCE_API_TOKEN=troque_pelo_api_token_da_primaria

# -----------------------------------------------------------------------------
# 8. Cloudflare DNS — backup em producao
# -----------------------------------------------------------------------------
# A troca automatica (take-over) so roda com NODE_ENV=production.
# Os comandos npm run dns:* continuam funcionando em qualquer ambiente e leem
# este bloco; para usar o CLI em desenvolvimento, inclua estas variaveis no .env.
#
# Token da API com permissao Zone > DNS > Edit na zona.
CLOUDFLARE_API_TOKEN=troque_pelo_token_da_api_cloudflare

# Zone ID da zona url.com.br (32 caracteres hex).
CLOUDFLARE_ZONE_ID=troque_pelo_zone_id

# Registro que alterna entre primario e backup.
CLOUDFLARE_DNS_RECORD_NAME=bot.url.com.br

# Alvo primario: bot.url.com.br -> bot-primary.url.com.br
# (o CNAME bot-primary -> <uuid>.cfargotunnel.com e criado separadamente)
CLOUDFLARE_DNS_PRIMARY_TYPE=CNAME
CLOUDFLARE_DNS_PRIMARY_CONTENT=bot-primary.url.com.br
CLOUDFLARE_DNS_PRIMARY_PROXIED=true

# Alvo de backup: bot.url.com.br -> bot-backup.url.com.br
# (o CNAME bot-backup -> <uuid>.cfargotunnel.com e criado separadamente)
CLOUDFLARE_DNS_BACKUP_TYPE=CNAME
CLOUDFLARE_DNS_BACKUP_CONTENT=bot-backup.url.com.br
CLOUDFLARE_DNS_BACKUP_PROXIED=true

# TTL em segundos; ignorado quando proxied=true (a Cloudflare usa TTL automatico).
CLOUDFLARE_DNS_TTL=60

# -----------------------------------------------------------------------------
# 9. Opcionais lidas diretamente do ambiente (fora do config.ts)
# -----------------------------------------------------------------------------
# Desativa a sonda de desvio de relogio do painel de status.
# CLOCK_OFFSET_ENABLED=false

# Densidade da imagem de status (minimo 72, padrao 144, 96 reduz CPU).
# STATUS_IMAGE_DENSITY=144

# -----------------------------------------------------------------------------
# VERSION nao e configurada aqui: config.ts usa a versao do package.json.
# -----------------------------------------------------------------------------
